# Schedule definitions for thorn GibbonsMaedaEvolve

# Schedule GibbonsMaeda evolution if evolution_method=GibbonsMaedaEvolve
if (CCTK_EQUALS (evolution_method, "GibbonsMaedaEvolve")) {

  STORAGE: rhs_Ei rhs_Ai rhs_Aphi rhs_Zeta
  STORAGE: rhs_phi1, rhs_Kphi1
  STORAGE: rhs_phi2, rhs_Kphi2
  STORAGE: hmetric conf_fac_chi trk
  STORAGE: EMD_jr_phi_gfs[3] EMD_Sir_phi_gfs[3]
  STORAGE: EMD_jr_F_gfs[3] EMD_Sir_F_gfs[3]

  schedule GibbonsMaeda_InitSymBound at BASEGRID
  {
    LANG: Fortran
    OPTIONS: META
  } "Schedule symmetries"

  schedule GibbonsMaeda_zero_rhs at BASEGRID after GibbonsMaeda_InitSymBound
  {
    LANG: Fortran
  } "set all rhs functions to zero to prevent spurious nans"

  schedule GibbonsMaeda_RegisterVars in MoL_Register
  {
    LANG: C
    OPTIONS: META
  } "Register variables for MoL"

  schedule GibbonsMaeda_calc_rhs in MoL_CalcRHS as GibbonsMaeda_CalcRHS
  {
    LANG: Fortran
  } "MoL RHS calculation for GibbonsMaeda variables"

  schedule GibbonsMaeda_calc_rhs_bdry in MoL_CalcRHS \
           as GibbonsMaeda_CalcRHS_Bdry after GibbonsMaeda_CalcRHS
  {
    LANG: Fortran
  } "MoL boundary RHS calculation for GibbonsMaeda variables"

  schedule GibbonsMaeda_Boundaries in MoL_PostStep
  {
    LANG: Fortran
    OPTIONS: LEVEL
    SYNC: ProcaBase::Ei
    SYNC: ProcaBase::Ai
    SYNC: ProcaBase::Aphi
    SYNC: ProcaBase::Zeta
    SYNC: ScalarBase::phi
    SYNC: ScalarBase::Kphi
    SYNC: GibbonsMaedaEvolve::EMD_jr_phi_gfs
    SYNC: GibbonsMaedaEvolve::EMD_Sir_phi_gfs
    SYNC: GibbonsMaedaEvolve::EMD_jr_F_gfs
    SYNC: GibbonsMaedaEvolve::EMD_Sir_F_gfs
  } "MoL boundary enforcement for GibbonsMaeda variables"

  schedule GROUP ApplyBCs as GibbonsMaeda_ApplyBCs in MoL_PostStep \
           after GibbonsMaeda_Boundaries
  {
  } "Apply boundary conditions"


  schedule GibbonsMaeda_calc_Tmunu in AddToTmunu as GibbonsMaeda_AddToTmunu
  {
    LANG: Fortran
    WRITES: GibbonsMaedaEvolve::EMD_jr_phi_gfs(everywhere)
    WRITES: GibbonsMaedaEvolve::EMD_Sir_phi_gfs(everywhere)
    WRITES: GibbonsMaedaEvolve::EMD_jr_F_gfs(everywhere)
    WRITES: GibbonsMaedaEvolve::EMD_Sir_F_gfs(everywhere)
  } "Compute the energy-momentum tensor"

}
