# Interface definition for thorn QuasiLocalMeasuresEMD

IMPLEMENTS: QuasiLocalMeasuresEMD

INHERITS: ADMBase SphericalSurface TmunuBase ProcaBase



CCTK_POINTER_TO_CONST \
FUNCTION GetMPICommWorld (CCTK_POINTER_TO_CONST IN cctkGH)
USES FUNCTION GetMPICommWorld

# translate SphericalSurface name into ID
CCTK_INT \
FUNCTION sf_IdFromName (CCTK_INT IN id, CCTK_POINTER_TO_CONST IN name)
USES FUNCTION sf_IdFromName



INT qlm_emd_state[num_surfaces] TYPE=scalar
{
  qlm_emd_calc_error          # some QLM information is invalid
  qlm_emd_have_valid_data     # interpolating from the AH was successful
  qlm_emd_have_killing_vector # we found a Killing vector field
  qlm_emd_timederiv_order     # order of time derivatives
  qlm_emd_iteration           # iteration for current data
} "Status information"

INT qlm_emd_state_p[num_surfaces] TYPE=scalar
{
  qlm_emd_have_valid_data_p qlm_emd_have_valid_data_p_p
  qlm_emd_have_killing_vector_p qlm_emd_have_killing_vector_p_p
} "Previous status information"
  
INT qlm_emd_grid_int[num_surfaces] TYPE=scalar
{
  qlm_emd_nghoststheta qlm_emd_nghostsphi
  qlm_emd_ntheta qlm_emd_nphi
} "Grid description"

REAL qlm_emd_grid_real[num_surfaces] TYPE=scalar
{
  qlm_emd_origin_x qlm_emd_origin_y qlm_emd_origin_z
  qlm_emd_origin_theta qlm_emd_origin_phi
  qlm_emd_delta_theta qlm_emd_delta_phi
} "Grid description"

REAL qlm_emd_grid_real_p[num_surfaces] TYPE=scalar
{
  qlm_emd_origin_x_p qlm_emd_origin_y_p qlm_emd_origin_z_p
  qlm_emd_origin_x_p_p qlm_emd_origin_y_p_p qlm_emd_origin_z_p_p
} "Previous grid description"

REAL qlm_emd_shapes[num_surfaces] TYPE=array DIM=2 SIZE=SphericalSurface::maxntheta,SphericalSurface::maxnphi DISTRIB=constant TAGS='convergence_power=1'
{
  qlm_emd_shape
} "Shape of the surface"

REAL qlm_emd_shapes_p[num_surfaces] TYPE=array DIM=2 SIZE=SphericalSurface::maxntheta,SphericalSurface::maxnphi DISTRIB=constant TAGS='convergence_power=1'
{
  qlm_emd_shape_p qlm_emd_shape_p_p
} "Previous shapes of the surface"

REAL qlm_emd_coordinates[num_surfaces] TYPE=array DIM=2 SIZE=SphericalSurface::maxntheta,SphericalSurface::maxnphi DISTRIB=constant TAGS='convergence_power=1'
{
  qlm_emd_x qlm_emd_y qlm_emd_z
} "Cartesian coordinates of the grid points on the surface"

# TODO: make this group private, i.e., move it into qlm_emd_variables.F90
REAL qlm_emd_coordinates_p[num_surfaces] TYPE=array DIM=2 SIZE=SphericalSurface::maxntheta,SphericalSurface::maxnphi DISTRIB=constant TAGS='convergence_power=1'
{
  qlm_emd_x_p qlm_emd_y_p qlm_emd_z_p
  qlm_emd_x_p_p qlm_emd_y_p_p qlm_emd_z_p_p
} "Past Cartesian coordinates of the grid points on the surface"

REAL qlm_emd_tetrad_l[num_surfaces] TYPE=array DIM=2 SIZE=SphericalSurface::maxntheta,SphericalSurface::maxnphi DISTRIB=constant TAGS='convergence_power=1'
{
  # all components are contravariant
  qlm_emd_l0 qlm_emd_l1 qlm_emd_l2 qlm_emd_l3       # outward null normal
} "Tetrad vector l^mu"

REAL qlm_emd_tetrad_n[num_surfaces] TYPE=array DIM=2 SIZE=SphericalSurface::maxntheta,SphericalSurface::maxnphi DISTRIB=constant TAGS='convergence_power=1'
{
  # all components are contravariant
  qlm_emd_n0 qlm_emd_n1 qlm_emd_n2 qlm_emd_n3       # inward null normal
} "Tetrad vector n^mu"

COMPLEX qlm_emd_tetrad_m[num_surfaces] TYPE=array DIM=2 SIZE=SphericalSurface::maxntheta,SphericalSurface::maxnphi DISTRIB=constant TAGS='convergence_power=1'
{
  # all components are contravariant
  qlm_emd_m0 qlm_emd_m1 qlm_emd_m2 qlm_emd_m3       # null normal within surface
} "Tetrad vector m^mu"

COMPLEX qlm_emd_newman_penrose[num_surfaces] TYPE=array DIM=2 SIZE=SphericalSurface::maxntheta,SphericalSurface::maxnphi DISTRIB=constant TAGS='Checkpoint="no",convergence_power=1'
{
  qlm_emd_npkappa qlm_emd_nptau qlm_emd_npsigma qlm_emd_nprho
  qlm_emd_npepsilon qlm_emd_npgamma qlm_emd_npbeta qlm_emd_npalpha
  qlm_emd_nppi qlm_emd_npnu qlm_emd_npmu qlm_emd_nplambda
#  qlm_emd_lie_l_npsigma
#  qlm_emd_lie_n_npsigma # for the Bondi mass
} "Newman-Penrose quantities"

COMPLEX qlm_emd_weyl_scalars[num_surfaces] TYPE=array DIM=2 SIZE=SphericalSurface::maxntheta,SphericalSurface::maxnphi DISTRIB=constant TAGS='Checkpoint="no",convergence_power=1'
{
  qlm_emd_psi0 # should be zero for an IH
  qlm_emd_psi1 # should be zero for an IH
  qlm_emd_psi2 # Im Psi_2 defines the angular momentum
  qlm_emd_psi3
  qlm_emd_psi4
  qlm_emd_i qlm_emd_j # curvature invariants I and J
  qlm_emd_s      # speciality index S = 27 J^2 / I^3
  qlm_emd_sdiff  # (27 J^2 - I^3) / L_2[Psi_n]^3
} "Weyl scalars (aka Newman-Penrose spin coefficients)"

REAL qlm_emd_ricci_scalars[num_surfaces] TYPE=array DIM=2 SIZE=SphericalSurface::maxntheta,SphericalSurface::maxnphi DISTRIB=constant TAGS='Checkpoint="no",convergence_power=1'
{
  qlm_emd_phi00                     # Ricci tensor
  qlm_emd_phi11
  qlm_emd_phi01
  qlm_emd_phi12
  qlm_emd_phi10
  qlm_emd_phi21
  qlm_emd_phi02
  qlm_emd_phi22
  qlm_emd_phi20
  
  qlm_emd_lambda                    # Ricci scalar
  
  qlm_emd_lie_n_theta_l             # Lie_n Theta_(l)
} "Ricci scalars"

REAL qlm_emd_twometric[num_surfaces] TYPE=array DIM=2 SIZE=SphericalSurface::maxntheta,SphericalSurface::maxnphi DISTRIB=constant TAGS='Checkpoint="no",convergence_power=1'
{
  qlm_emd_qtt qlm_emd_qtp qlm_emd_qpp
  qlm_emd_rsc                       # 2-Ricci scalar
} "2-metric"

REAL qlm_emd_killing_vector[num_surfaces] TYPE=array DIM=2 SIZE=SphericalSurface::maxntheta,SphericalSurface::maxnphi DISTRIB=constant TAGS='convergence_power=1'
{
  qlm_emd_xi_t qlm_emd_xi_p
  qlm_emd_chi
} "Killing vector field"

REAL qlm_emd_killed_twometric[num_surfaces] TYPE=array DIM=2 SIZE=SphericalSurface::maxntheta,SphericalSurface::maxnphi DISTRIB=constant TAGS='Checkpoint="no",convergence_power=1'
{
  qlm_emd_lqtt qlm_emd_lqtp qlm_emd_lqpp
} "Lie derivative of the 2-metric along the Killing vector field"

REAL qlm_emd_invariant_coordinates[num_surfaces] TYPE=array DIM=2 SIZE=SphericalSurface::maxntheta,SphericalSurface::maxnphi DISTRIB=constant TAGS='Checkpoint="no",convergence_power=1'
{
  qlm_emd_inv_z
} "Invariant coordinates on the surface, assuming axisymmetry"

REAL qlm_emd_multipole_moments[num_surfaces] TYPE=scalar TAGS='Checkpoint="no"'
{
  qlm_emd_mp_m0 qlm_emd_mp_m1 qlm_emd_mp_m2 qlm_emd_mp_m3 qlm_emd_mp_m4 qlm_emd_mp_m5 qlm_emd_mp_m6 qlm_emd_mp_m7 qlm_emd_mp_m8
  qlm_emd_mp_j0 qlm_emd_mp_j1 qlm_emd_mp_j2 qlm_emd_mp_j3 qlm_emd_mp_j4 qlm_emd_mp_j5 qlm_emd_mp_j6 qlm_emd_mp_j7 qlm_emd_mp_j8
} "Mass and spin multipole moments"

REAL qlm_emd_3determinant[num_surfaces] TYPE=array DIM=2 SIZE=SphericalSurface::maxntheta,SphericalSurface::maxnphi DISTRIB=constant TAGS='Checkpoint="no",convergence_power=1'
{
  qlm_emd_3det
} "3-Determinant of H for a special choice of the triad"

REAL qlm_emd_scalars[num_surfaces] TYPE=scalar
{
  qlm_emd_time
  qlm_emd_equatorial_circumference
  qlm_emd_polar_circumference_0
  qlm_emd_polar_circumference_pi_2
  # area A and areal radius R
  qlm_emd_area qlm_emd_irreducible_mass qlm_emd_radius
  qlm_emd_spin_guess qlm_emd_mass_guess
  qlm_emd_killing_eigenvalue_re qlm_emd_killing_eigenvalue_im
  # spin J: J = a M^2, i.e., angular momentum (spin is a misnomer)
  qlm_emd_spin qlm_emd_npspin qlm_emd_wsspin qlm_emd_cvspin
  qlm_emd_coordspinx qlm_emd_coordspiny qlm_emd_coordspinz
  # mass M : total mass, i.e., including angular momentum
  qlm_emd_mass
  qlm_emd_adm_energy
  qlm_emd_adm_momentum_x qlm_emd_adm_momentum_y qlm_emd_adm_momentum_z
  qlm_emd_adm_angular_momentum_x qlm_emd_adm_angular_momentum_y qlm_emd_adm_angular_momentum_z
  qlm_emd_w_energy
  qlm_emd_w_momentum_x qlm_emd_w_momentum_y qlm_emd_w_momentum_z
  qlm_emd_w_angular_momentum_x qlm_emd_w_angular_momentum_y qlm_emd_w_angular_momentum_z
  qlm_emd_electric_charge
} "Scalar quantities on the surface"

REAL qlm_emd_scalars_p[num_surfaces] TYPE=scalar
{
  qlm_emd_time_p qlm_emd_time_p_p
  qlm_emd_radius_p qlm_emd_radius_p_p
} "Some scalar quantities on the surface at previous times"
