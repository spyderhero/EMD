# Schedule definitions for thorn EMDGaussSolver

schedule EMD_C_ParamCheck AT PARAMCHECK
{
  LANG: C
  OPTIONS: GLOBAL
} "Check parameters"

schedule GROUP EMD_Initial_Data IN ADMBase_Initial
{
  SYNC:ADMBase::metric,ADMBase::curv,ADMBase::lapse,ADMBase::shift
  SYNC:ScalarBase::phi(Everywhere), ScalarBase::Kphi(Everywhere)
  SYNC:ProcaBase::Ei(everywhere), ProcaBase::Ai(everywhere), ProcaBase::Aphi(everywhere), ProcaBase::Zeta(everywhere)
} "Group for the EMD initial data"

if (CCTK_Equals(initial_data, "emd") || CCTK_Equals(initial_hydro, "emd"))
{
  schedule EMD_C_Exact IN EMD_Initial_Data
  {
    LANG: C
    READS: StaticConformal::conformal_state
    READS: ADMBase::shift_state
    READS: GRID::coordinates
    WRITES: ADMBASE::alp(everywhere)
    WRITES: ADMBASE::curv(everywhere)
    WRITES: ADMBASE::metric_p_p(everywhere)
    WRITES: ADMBASE::metric_p(everywhere)
    WRITES: ADMBASE::metric(everywhere)
    WRITES: ADMBASE::shift(everywhere)
    WRITES: ScalarBase::phi(Everywhere), ScalarBase::Kphi(Everywhere)
    WRITES: ProcaBase::Ei(everywhere), ProcaBase::Ai(everywhere),
            ProcaBase::Aphi(everywhere), ProcaBase::Zeta(everywhere)
    WRITES: StaticConformal::psi(everywhere)
    WRITES: StaticConformal::confac_1derivs(everywhere)
    WRITES: StaticConformal::confac_2derivs(everywhere)
  } "Set up the 3d quantities for the scalar and vector variables"
}

