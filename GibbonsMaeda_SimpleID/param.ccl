# Parameter definitions

SHARES: ADMBase

USES KEYWORD metric_type

EXTENDS KEYWORD initial_data
{
  "GM_simpleID" :: "Initial data for GibbonsMaeda"
  "GM_GHS" :: "GM-GHS solution Initial data"
}

EXTENDS KEYWORD initial_lapse
{
  "psi^n"   :: "psi^n initial lapse profile"
  "GM_GHS" :: "GM-GHS solution Initial data"
}


# share asymptotic value
SHARES: ScalarBase
USES CCTK_REAL phi1_0
USES CCTK_REAL phi2_0

shares: ProcaBase
USES CCTK_REAL Aphi0

RESTRICTED:


REAL par_b "x coordinate of the puncture" STEERABLE=always
{
  (0.0:*) :: ""
} 1.e-5

REAL par_m_plus "mass of the m+ puncture" STEERABLE = ALWAYS
{
  0.0:*) :: ""
} 1.0

REAL par_m_minus "mass of the m- puncture" STEERABLE = ALWAYS
{
  0.0:*) :: ""
} 0.0

REAL par_q_plus "electric charge of the m+ puncture" STEERABLE = ALWAYS
{
  (*:*) :: ""
} 0.0

REAL par_q_minus "electric charge of the m- puncture" STEERABLE = ALWAYS
{
  (*:*) :: ""
} 0.0

REAL par_qm_plus "magnetic charge of the m+ puncture" STEERABLE = ALWAYS
{
  (*:*) :: ""
} 0.0

REAL par_qm_minus "magnetic charge of the m- puncture" STEERABLE = ALWAYS
{
  (*:*) :: ""
} 0.0

REAL initial_lapse_psi_exponent "Exponent n for psi^-n initial lapse profile"
{
  (*:*) :: "Should be negative"
} -2.0

BOOLEAN swap_xz "Swap x and z coordinates when interpolating, so that the black holes are separated in the z direction"
{
} "no"
